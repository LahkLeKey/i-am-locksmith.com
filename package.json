{
  "name": "nextjs-clerk-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "vercel:pull:dev": "vercel env pull .env.development.local --environment=development --yes",
    "vercel:pull:preview": "vercel env pull .env.preview.local --environment=preview --yes",
    "vercel:pull:prod": "vercel env pull .env.production.local --environment=production --yes",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:production": "node --env-file=.env.production.local node_modules/@playwright/test/cli.js test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.2.2",
    "@clerk/ui": "^1.6.2",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^24.0.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "marked": "^16.3.0",
    "next": "16.2.4",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.10",
    "prism-react-renderer": "^2.4.1",
    "quill-delta": "^5.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-leaflet": "^5.0.0",
    "react-quill-new": "^3.8.3",
    "react-syntax-highlighter": "^15.6.1",
    "tailwindcss": "^4.2.2",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.11",
    "@playwright/test": "^1.61.1",
    "@types/leaflet": "^1.9.21",
    "@types/turndown": "^5.0.5",
    "dotenv": "^17.4.2",
    "prisma": "^6.19.3",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800"
}
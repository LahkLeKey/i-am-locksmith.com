generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model DashboardSnapshot {
    id                  String   @id @default(cuid())
    orgId               String   @default("org_seed_default")
    generatedAt         DateTime
    revenueToday        Int
    openInvoices        Int
    grossMarginWeek     Decimal  @db.Decimal(6, 2)
    lowStockSkus        Int
    vansBelowMin        Int
    financialTrend      Json
    kpis                Json
    jobsQueue           Json
    replenishmentAlerts Json
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    @@index([generatedAt])
    @@index([orgId, generatedAt])
}

model InventoryPart {
    id                String   @id @default(cuid())
    orgId             String
    sku               String
    itemName          String
    estimatedUnitCost Decimal  @default(35) @db.Decimal(10, 2)
    serviceLines      Json
    location          String
    onHand            Int
    reorderPoint      Int
    suggestedOrderQty Int
    supplier          String
    severity          String
    compatibilityNote String
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    @@index([orgId, sku])
    @@index([orgId, location])
}

model InventoryLedgerEntry {
    id            String   @id @default(cuid())
    orgId         String
    sku           String
    location      String
    delta         Int
    kind          String
    note          String?
    referenceId   String?
    referenceType String?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    @@index([orgId, sku, location, createdAt])
    @@index([orgId, kind, createdAt])
}

model JobRecord {
    id                     String    @id @default(cuid())
    jobNumber              String
    orgId                  String
    customerName           String
    site                   String
    priority               String
    status                 String
    scheduledFor           DateTime?
    etaMinutes             Int?
    requiredSkus           Json
    followUpNote           String?
    assignedTechnicianIds  Json      @default("[]")
    assignedTechnicianName String?
    laborRate              Decimal?  @db.Decimal(10, 2)
    partEstimate           Decimal   @db.Decimal(10, 2)
    laborEstimate          Decimal   @db.Decimal(10, 2)
    estimatedMinutes       Int
    estimatedTotal         Decimal   @db.Decimal(10, 2)
    quoteNotes             String?
    clockedInAt            DateTime?
    clockedOutAt           DateTime?
    breakMinutes           Int       @default(0)
    timeClockNotes         String?
    timeClockLedger        Json      @default("[]")
    actualPartCost         Decimal?  @db.Decimal(10, 2)
    actualLaborCost        Decimal?  @db.Decimal(10, 2)
    actualMinutes          Int?
    finalTotal             Decimal?  @db.Decimal(10, 2)
    closedOutAt            DateTime?
    closeoutNotes          String?
    createdAt              DateTime  @default(now())
    updatedAt              DateTime  @updatedAt

    @@unique([orgId, jobNumber])
    @@index([orgId, status, updatedAt])
}

model Technician {
    id                 String   @id @default(cuid())
    orgId              String
    fullName           String
    lockpickingSkills  Json
    hourlyRate         Decimal  @db.Decimal(10, 2)
    availabilityStatus String
    availabilityNote   String?
    isActive           Boolean  @default(true)
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt

    @@index([orgId, isActive])
    @@index([orgId, fullName])
}

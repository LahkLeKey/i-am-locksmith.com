generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model DashboardSnapshot {
    id                  String   @id @default(cuid())
    orgId               String   @default("org_seed_default")
    generatedAt         DateTime
    revenueToday        Int
    openInvoices        Int
    grossMarginWeek     Decimal  @db.Decimal(6, 2)
    lowStockSkus        Int
    vansBelowMin        Int
    financialTrend      Json
    kpis                Json
    jobsQueue           Json
    replenishmentAlerts Json
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt

    @@index([generatedAt])
    @@index([orgId, generatedAt])
}

model InventoryPart {
    id                String   @id @default(cuid())
    orgId             String
    sku               String
    itemName          String
    estimatedUnitCost Decimal  @default(35) @db.Decimal(10, 2)
    serviceLines      Json
    location          String
    onHand            Int
    reorderPoint      Int
    suggestedOrderQty Int
    supplier          String
    severity          String
    compatibilityNote String
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    @@index([orgId, sku])
    @@index([orgId, location])
}

model InventoryLedgerEntry {
    id            String   @id @default(cuid())
    orgId         String
    sku           String
    location      String
    delta         Int
    kind          String
    note          String?
    referenceId   String?
    referenceType String?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    @@index([orgId, sku, location, createdAt])
    @@index([orgId, kind, createdAt])
}

model InventoryLocation {
    id        String   @id @default(cuid())
    orgId     String
    name      String
    type      String
    address   String?
    latitude  Decimal? @db.Decimal(9, 6)
    longitude Decimal? @db.Decimal(9, 6)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([orgId, name])
    @@index([orgId, type, name])
}

model GeoCacheEntry {
    id                String   @id @default(cuid())
    cacheKey          String   @unique @db.VarChar(128)
    namespace         String   @db.VarChar(50)
    provider          String   @db.VarChar(30)
    endpoint          String   @db.VarChar(50)
    requestHash       String   @db.VarChar(64)
    normalizedRequest Json
    response          Json
    responseStatus    Int      @default(200)
    byteSize          Int?
    regionKey         String?  @db.VarChar(100)
    dataVersion       String?  @db.VarChar(100)
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt
    expiresAt         DateTime
    staleUntil        DateTime
    refreshLeaseUntil DateTime?
    refreshLeaseOwner String?  @db.VarChar(100)
    lastAccessedAt    DateTime @default(now())
    hitCount          BigInt   @default(0)
    errorCount        Int      @default(0)

    @@index([namespace, expiresAt])
    @@index([provider, endpoint, expiresAt])
    @@index([regionKey, expiresAt])
    @@index([lastAccessedAt])
}

model GeoProviderQuota {
    provider      String   @id @db.VarChar(30)
    nextAllowedAt DateTime
    updatedAt     DateTime @updatedAt
}

model GeoCacheLease {
    cacheKey   String   @id @db.VarChar(128)
    owner      String   @db.VarChar(100)
    leaseUntil DateTime
    updatedAt  DateTime @updatedAt

    @@index([leaseUntil])
}

model ReplenishmentRequest {
    id                String   @id @default(cuid())
    orgId             String
    sku               String
    location          String
    supplier          String
    requestedQuantity Int
    status            String   @default("open")
    requestedByUserId String
    orderingNotes     String?
    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    @@index([orgId, status, createdAt])
    @@index([orgId, sku, location, status])
}

model JobRecord {
    id                     String    @id @default(cuid())
    jobNumber              String
    jobName                String
    orgId                  String
    customerName           String
    site                   String
    latitude               Decimal?  @db.Decimal(9, 6)
    longitude              Decimal?  @db.Decimal(9, 6)
    priority               String
    status                 String
    scheduledFor           DateTime?
    etaMinutes             Int?
    requiredSkus           Json
    followUpNote           String?
    assignedTechnicianIds  Json      @default("[]")
    assignedTechnicianName String?
    laborRate              Decimal?  @db.Decimal(10, 2)
    partEstimate           Decimal   @db.Decimal(10, 2)
    laborEstimate          Decimal   @db.Decimal(10, 2)
    estimatedMinutes       Int
    estimatedTotal         Decimal   @db.Decimal(10, 2)
    quoteNotes             String?
    clockedInAt            DateTime?
    clockedOutAt           DateTime?
    breakMinutes           Int       @default(0)
    timeClockNotes         String?
    timeClockLedger        Json      @default("[]")
    actualPartCost         Decimal?  @db.Decimal(10, 2)
    actualLaborCost        Decimal?  @db.Decimal(10, 2)
    actualMinutes          Int?
    finalTotal             Decimal?  @db.Decimal(10, 2)
    closedOutAt            DateTime?
    closeoutNotes          String?
    invoice                Invoice?
    createdAt              DateTime  @default(now())
    updatedAt              DateTime  @updatedAt

    @@unique([orgId, jobNumber])
    @@index([orgId, status, updatedAt])
}

model Invoice {
    id                String           @id @default(cuid())
    orgId             String
    invoiceNumber     String
    jobId             String           @unique
    jobNumber         String
    customerName      String
    site              String
    subtotal          Decimal          @db.Decimal(10, 2)
    taxAmount         Decimal          @default(0) @db.Decimal(10, 2)
    totalAmount       Decimal          @db.Decimal(10, 2)
    status            String           @default("draft")
    notes             String?
    finalizedAt       DateTime?
    finalizedByUserId String?
    paidAt            DateTime?
    createdAt         DateTime         @default(now())
    updatedAt         DateTime         @updatedAt
    job               JobRecord        @relation(fields: [jobId], references: [id], onDelete: Restrict)
    payments          InvoicePayment[]

    @@unique([orgId, invoiceNumber])
    @@unique([orgId, jobNumber])
    @@index([orgId, status, finalizedAt])
}

model InvoicePayment {
    id               String   @id @default(cuid())
    orgId            String
    invoiceId        String
    amount           Decimal  @db.Decimal(10, 2)
    method           String
    reference        String?
    notes            String?
    receivedAt       DateTime
    recordedByUserId String
    createdAt        DateTime @default(now())
    invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

    @@index([orgId, invoiceId, receivedAt])
    @@index([orgId, receivedAt])
}

model Technician {
    id                 String   @id @default(cuid())
    orgId              String
    fullName           String
    lockpickingSkills  Json
    hourlyRate         Decimal  @db.Decimal(10, 2)
    availabilityStatus String
    availabilityNote   String?
    isActive           Boolean  @default(true)
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt

    @@index([orgId, isActive])
    @@index([orgId, fullName])
}
